{
    "model": {
        "name": "cborg-gpt-4.1-mini"
    },
    "prompts": {
        "welcome_message": "Hello! I'm here to help you with your NERSC questions. What would you like to know?",
        "goodbye_message": "Goodbye! Feel free to ask more questions anytime."
    },
    "debug": false,
    "docs_folder": "nersc-docs/docs",
    "search": {
        "default_nb_lines_outputs": 5,
        "include_folder_structure": false,
        "ignored_folders": [
            "timeline",
            "images",
            "Images",
            "img"
        ],
        "ignored_extensions": [
            "gif",
            "jpg",
            "png",
            "svg",
            "css",
            "js",
            "xml",
            "pdf",
            "gitkeep"
        ]
    }
}